// nevermore.rc - Windows resource script
//
// Embeds the application icon and version metadata into nevermore.exe
// (compiled via windres, see src/Makefile.am). The icon is the committed
// six-size icons/nevermore.ico, rendered from icons/nevermore.svg — the
// regeneration recipe is the top-level Makefile's `regen-icon` target.
//
// The version is NOT written here: it comes from the build-generated
// nevermore_version.h, the single version source (git-version.sh,
// recomputed on every make). A hand-kept number is what let the .exe's
// Properties tab report 0.0.15 while the tree was at 0.0.311. VERSIONINFO's
// quad is four fields; the product version is three-component, so the
// revision field is 0.

#include <windows.h>
#include "nevermore_version.h"

#define VER_FILEVERSION     NEVERMORE_VERSION_MAJOR,NEVERMORE_VERSION_MINOR,NEVERMORE_VERSION_PATCH,0
#define VER_FILEVERSION_STR NEVERMORE_VERSION
#define VER_PRODUCTVERSION  VER_FILEVERSION
#define VER_PRODUCTVERSION_STR VER_FILEVERSION_STR

IDI_NEVERMORE ICON "../icons/nevermore.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "chestso"
            VALUE "FileDescription",  "nevermore - interactive coding agent"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "nevermore"
            VALUE "LegalCopyright",   "no rights reserved"
            VALUE "OriginalFilename", "nevermore.exe"
            VALUE "ProductName",      "nevermore"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
