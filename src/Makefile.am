# src/Makefile.am - Build rules for nevermore source files

# Regenerate nevermore_version.h on every `make` so the embedded version
# string tracks the current git HEAD (including a -dirty suffix when the
# working tree has uncommitted changes). The recipe always runs, but the
# file is only rewritten when the version actually changes — so dependent
# .o files stay cached when nothing changed.
#
# The three numeric fields exist for the Windows version QUAD
# (src/nevermore.rc builds FILEVERSION/PRODUCTVERSION from them), which
# is why each is reduced to digits: a tag with fewer components than
# X.Y.Z leaves a field empty, and `FILEVERSION 1,0,,0` is not a resource
# windres can compile. A component that is not plain digits (a suffix
# surviving the base split) contributes its digits and nothing else —
# never an unexpanded macro, never an empty one.
BUILT_SOURCES = nevermore_version.h
CLEANFILES = nevermore_version.h

.PHONY: nevermore_version_force
nevermore_version.h: nevermore_version_force
	@v=`"$(top_srcdir)/build-aux/git-version.sh" "$(top_srcdir)" 2>/dev/null`; \
	test -n "$$v" || v="$(NEVERMORE_VERSION)"; \
	test -n "$$v" || v="unknown"; \
	base=`echo "$$v" | sed 's/-.*//'`; \
	field() { \
	  f=`echo "$$1" | cut -d. -f"$$2" | tr -cd '0-9'`; \
	  test -n "$$f" || f=0; \
	  echo "$$f"; \
	}; \
	major=`field "$$base" 1`; \
	minor=`field "$$base" 2`; \
	patch=`field "$$base" 3`; \
	printf '/* Generated by src/Makefile.am from build-aux/git-version.sh —\n * do not edit. The numeric fields are the Windows version quad\n * src/nevermore.rc embeds; tests/test_version.c pins them. */\n#ifndef NEVERMORE_VERSION_H\n#define NEVERMORE_VERSION_H\n#define NEVERMORE_VERSION "%s"\n#define NEVERMORE_VERSION_MAJOR %s\n#define NEVERMORE_VERSION_MINOR %s\n#define NEVERMORE_VERSION_PATCH %s\n#endif\n' "$$v" "$$major" "$$minor" "$$patch" > $@.tmp; \
	if cmp -s $@.tmp $@ 2>/dev/null; then \
	  rm -f $@.tmp; \
	else \
	  mv $@.tmp $@; \
	  echo "  GEN      $@ ($$v)"; \
	fi
nevermore_version_force:

