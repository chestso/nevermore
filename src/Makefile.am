nevermore_CPPFLAGS = \
    -I$(top_builddir) \
    -I$(top_srcdir)/src \
    -I$(top_srcdir)/third_party/stb \
    -DNM_WIRE_HAS_VERSION_HEADER \
    $(BOBA_CFLAGS) \
    $(OPENSSL_CFLAGS) \
    $(MBEDTLS_CFLAGS)

nevermore_LDADD = $(BOBA_LIBS) $(OPENSSL_LIBS) $(MBEDTLS_LIBS)

# Windows resource file — embed application icon into the .exe via windres.
# The .rc takes its version fields from the build-generated
# nevermore_version.h, so the header's directory is on windres's include
# path and the rule waits for the header (BUILT_SOURCES orders `make all`;
# the explicit prerequisite covers a parallel build and `make -C src
# nevermore-res.o` on its own).
if HAVE_WINDRES
noinst_DATA = nevermore-res.o
nevermore_LDADD += nevermore-res.o

nevermore-res.o: $(srcdir)/nevermore.rc $(top_srcdir)/icons/nevermore.ico \
    nevermore_version.h
	$(WINDRES) \
	    --define _UNICODE --define UNICODE \
	    -I$(top_builddir)/src \
	    -I$(top_srcdir) \
	    -I$(srcdir) \
	    $(srcdir)/nevermore.rc -O coff -o $@
endif
